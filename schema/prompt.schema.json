{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flatkey-ai/awesome-seedance-prompts/schema/prompt.schema.json",
  "title": "Awesome Seedance Prompt",
  "type": "object",
  "required": ["slug", "model", "industry", "category", "title", "source", "status", "prompt"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "model": { "type": "string", "minLength": 1 },
    "industry": {
      "type": "string",
      "enum": [
        "automotive-mobility",
        "creator-social",
        "ecommerce-retail",
        "education-training",
        "gaming",
        "marketing-advertising",
        "media-entertainment",
        "travel-hospitality"
      ]
    },
    "category": {
      "type": "string",
      "enum": ["action", "cinematic", "commercial", "pov-fpv", "reference-driven", "surreal-vfx", "character-consistency", "storyboard", "music-video", "transition"]
    },
    "title": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } },
    "summary": { "type": "object", "additionalProperties": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["label", "platform", "url", "license"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["video", "image", "audio", "storyboard"] },
        "url": { "type": "string", "format": "uri" },
        "poster": { "type": "string", "format": "uri" },
        "duration": { "type": "number", "minimum": 0 },
        "ratio": { "type": "string" }
      },
      "additionalProperties": true
    },
    "status": { "enum": ["draft", "published", "archived"] },
    "featured": { "type": "boolean" },
    "prompt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
